# Copy to .env and adjust. A single root .env serves docker compose, the API and
# the worker, so there is one place to look when something is misconfigured.

NODE_ENV=development

# --- Database -----------------------------------------------------------------
# Must match the credentials in docker-compose.yml.
DATABASE_URL=postgresql://devflow:devflow@localhost:5432/devflow?schema=public

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- API ----------------------------------------------------------------------
API_PORT=4000
# Browser origin allowed to send credentialed requests to the API.
CORS_ORIGIN=http://localhost:3000

# --- Web ----------------------------------------------------------------------
# NEXT_PUBLIC_ variables are inlined into the browser bundle. Never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:4000
