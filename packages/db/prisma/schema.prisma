// DevFlow AI — database schema.
//
// Models are added per milestone, starting with User in Milestone 1.
// Two conventions apply to everything added later:
//   1. Every organization-owned table carries organizationId directly, even when
//      it is derivable through a relation. Tenant filters stay single-table and
//      composite indexes stay possible.
//   2. Timestamps are @default(now()) / @updatedAt, never set by application code.

generator client {
  provider = "prisma-client-js"
}

// The connection URL lives in prisma.config.ts (Prisma 7 moved it out of the
// schema). The application client receives its connection through a driver
// adapter instead — see PrismaService.
datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  organizations OrganizationMember[]
  comments      Comment[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model Organization {
  id                  String               @id @default(uuid(7)) @db.Uuid
  name                String
  organizationMembers OrganizationMember[]
  projects            Project[]
  issues              Issue[]
  comments            Comment[]
  labels              Label[]
  issueLabels         IssueLabel[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           Role
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

enum Role {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

model Project {
  id             String  @id @default(uuid(7)) @db.Uuid
  name           String
  key            String
  organizationId String  @map("organization_id") @db.Uuid
  issueCounter   Int     @default(0) @map("issue_counter")
  issues         Issue[]

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("projects")
}

model Issue {
  id             String       @id @default(uuid(7)) @db.Uuid
  title          String
  number         Int
  projectId      String       @map("project_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  comments       Comment[]
  issueLabels    IssueLabel[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([id, organizationId])
  @@unique([projectId, number])
  @@index([organizationId])
  @@map("issues")
}

model Comment {
  id             String    @id @default(uuid(7)) @db.Uuid
  body           String
  authorId       String?   @map("author_id") @db.Uuid
  issueId        String    @map("issue_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  issue        Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([issueId])
  @@map("comments")
}

model Label {
  id             String       @id @default(uuid(7)) @db.Uuid
  name           String
  organizationId String       @map("organization_id") @db.Uuid
  issueLabels    IssueLabel[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@map("labels")
}

model IssueLabel {
  id             String @id @default(uuid(7)) @db.Uuid
  issueId        String @map("issue_id") @db.Uuid
  labelId        String @map("label_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  issue        Issue        @relation(fields: [issueId, organizationId], references: [id, organizationId], onDelete: Cascade)
  label        Label        @relation(fields: [labelId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([issueId, labelId])
  @@index([organizationId])
  @@index([labelId])
  @@map("issue_labels")
}
