{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "DevFlow Next.js",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "allowJs": true,
    "isolatedModules": true,

    // Next.js compiles with SWC; tsc is only used for type checking.
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,

    "plugins": [{ "name": "next" }]
  }
}
